[Unit]
Description=SmartBoard Display (cage + Chromium kiosk)
After=systemd-user-sessions.service smartboard-core.service plymouth-quit-wait.service
Wants=smartboard-core.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=smartboard
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland WLR_LIBINPUT_NO_DEVICES=1
ExecStartPre=/usr/local/lib/smartboard/wait-core
ExecStart=/usr/bin/cage -d -s -- /usr/local/lib/smartboard/kiosk-browser
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
