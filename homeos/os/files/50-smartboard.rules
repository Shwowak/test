polkit.addRule(function (action, subject) {
  if (subject.user != "smartboard") return polkit.Result.NOT_HANDLED;
  if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0) return polkit.Result.YES;
  var allowed = [
    "org.freedesktop.login1.reboot", "org.freedesktop.login1.reboot-multiple-sessions",
    "org.freedesktop.login1.power-off", "org.freedesktop.login1.power-off-multiple-sessions",
    "org.freedesktop.hostname1.set-hostname", "org.freedesktop.hostname1.set-static-hostname"
  ];
  if (allowed.indexOf(action.id) >= 0) return polkit.Result.YES;
  if (action.id == "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit"), verb = action.lookup("verb");
    if (unit == "smartboard-kiosk.service" && verb == "restart") return polkit.Result.YES;
    if (unit == "smartboard-update.service" && verb == "start") return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
